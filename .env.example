# -----------------------------------------------------------------------------
# Draft Ethan - Environment Variables Template
# -----------------------------------------------------------------------------

# 1. Google Gemini AI API Configuration
# - GEMINI_API_KEY: Required for cover letter corrections.
# - Grab one from Google AI Studio (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Supabase Database Configuration
# - VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://xyz.supabase.co).
# - VITE_SUPABASE_ANON_KEY: Client anon key (safe for client bundling).
# - SUPABASE_SERVICE_ROLE_KEY: Service role key used by the backend Express server
#   to update user profile rows (is_pro = true) in the profiles table, bypassing RLS.
#   ⚠️ DO NOT expose the service role key to the client side.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Toss Payments Billing Integration
# - VITE_TOSS_CLIENT_KEY: Client-side SDK key (Widget loader).
# - TOSS_SECRET_KEY: Server-side API key for Basic Auth payment confirmations.
# - (Notice: Default values below are standard test Sandbox credentials from Toss documentations)
VITE_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"
TOSS_SECRET_KEY="test_gck_docs_OaPz8L5KdmQXkzRz3y47BMw6"

# 4. App Service Configuration
# - APP_URL: The self-referential URL hosting the app layout.
# - NODE_ENV: Set to 'production' on deploy builds, or 'development' during local runs.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 5. Real-Time Discord Notification (Optional)
# - DISCORD_WEBHOOK_URL: Webhook URL for instant deposit notification to your Discord channel.
#   (Create via Discord Channel -> Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_DISCORD_WEBHOOK_URL"

